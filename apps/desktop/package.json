{
  "name": "dreambyte",
  "version": "0.7.28.0",
  "private": true,
  "description": "AI video editor: prompt to animated video, then edit every layer on a timeline.",
  "license": "MIT",
  "author": "Daniel Lopez",
  "homepage": "https://github.com/danrublop/dreambyte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danrublop/dreambyte.git"
  },
  "bugs": {
    "url": "https://github.com/danrublop/dreambyte/issues"
  },
  "keywords": [
    "video-editor",
    "ai",
    "animation",
    "electron",
    "motion-graphics"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run validate-env",
    "dev": "next dev",
    "prebuild": "npm run validate-env",
    "build:electron": "node scripts/build/build-electron.mjs",
    "build:renderer": "node scripts/build/build-renderer.mjs",
    "build:player": "vite build ../../packages/player",
    "build:icons": "electron-icon-builder --input=resources/icon-source.png --output=resources --flatten && node -e \"const fs=require('fs');fs.copyFileSync('resources/icons/icon.icns','resources/icon.icns');fs.copyFileSync('resources/icons/icon.ico','resources/icon.ico');fs.copyFileSync('resources/icons/1024x1024.png','resources/icon.png');\"",
    "dev:electron": "node scripts/build/ensure-renderer.mjs && concurrently -k -n esbuild,electron -c gray,magenta \"node scripts/build/build-electron.mjs --watch\" \"wait-on dist-electron/main.js && DREAMBYTE_FORCE_STATIC=1 electron .\"",
    "dev:electron:web": "concurrently -k -n esbuild,electron -c gray,magenta \"node scripts/build/build-electron.mjs --watch\" \"wait-on http://localhost:3000 && wait-on dist-electron/main.js && ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "dev:desktop": "node scripts/build/ensure-renderer.mjs && concurrently -k -n esbuild,renderer,electron -c gray,cyan,magenta \"node scripts/build/build-electron.mjs --watch\" \"node scripts/build/build-renderer.mjs --watch\" \"wait-on dist-electron/main.js && DREAMBYTE_FORCE_STATIC=1 electron .\"",
    "electron:dev": "npm run dev:electron",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:studio": "drizzle-kit studio --config src/lib/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config src/lib/db/drizzle.config.ts",
    "db:setup": "npx tsx scripts/db/setup.ts",
    "db:reset": "rm -f dev.db && npm run db:migrate && npm run db:setup",
    "gen:okf": "npx tsx scripts/okf/gen-okf-index.ts",
    "gen:okf:check": "npx tsx scripts/okf/gen-okf-index.ts --check",
    "gen:okf-viz": "npx tsx scripts/okf/gen-okf-viz.ts",
    "gen:okf-flow": "npx tsx scripts/okf/gen-okf-flow.ts",
    "gen:okf-docs": "npx tsx scripts/okf/gen-okf-docs.ts",
    "gen:okf-mirror": "npx tsx scripts/okf/gen-okf-mirror.ts",
    "gen:okf-mirror:check": "npx tsx scripts/okf/gen-okf-mirror.ts --check",
    "gen:memory-okf": "npx tsx scripts/okf/gen-memory-okf.ts",
    "mcp": "npx tsx scripts/mcp/mcp-server.ts",
    "sfx-library:fetch": "npx tsx scripts/assets/fetch-sfx-library.ts",
    "sfx-library:zzfx": "npx tsx scripts/assets/build-native-sfx-zzfx.ts",
    "sfx-library:packs": "node scripts/assets/fetch-sfx-packs.mjs",
    "music-sidecar:setup": "bash sidecars/musicgen/setup.sh",
    "music-sidecar:start": "bash sidecars/musicgen/start.sh",
    "soundfont:fetch": "node scripts/assets/fetch-soundfont.mjs",
    "magenta:fetch": "node scripts/assets/fetch-magenta.mjs",
    "validate-env": "npx tsx scripts/dev/validate-env.ts",
    "dist": "npm run assets:fetch && npm run build:renderer && npm run build:electron && npm run build:player && npm run build:icons && node scripts/release/package-app.mjs --publish never",
    "dist:mac": "npm run assets:fetch && npm run build:renderer && npm run build:electron && npm run build:player && npm run build:icons && node scripts/release/upload-sentry-symbols.mjs && node scripts/release/package-app.mjs --mac --publish never",
    "dist:win": "npm run assets:fetch && npm run build:renderer && npm run build:electron && npm run build:player && npm run build:icons && node scripts/release/upload-sentry-symbols.mjs && node scripts/release/package-app.mjs --win --publish never",
    "dist:dir": "npm run assets:fetch && npm run build:renderer && npm run build:electron && npm run build:player && npm run build:icons && node scripts/release/package-app.mjs --dir",
    "dist:publish": "npm run assets:fetch && npm run build:renderer && npm run build:electron && npm run build:player && npm run build:icons && node scripts/release/upload-sentry-symbols.mjs && node scripts/release/package-app.mjs --mac --publish always",
    "release": "node scripts/release/release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run",
    "eval": "npx tsx evals/runner/run-eval.ts",
    "eval:scene-codegen": "npx tsx evals/runner/run-eval.ts --suite scene-codegen",
    "eval:memory-ab": "npx tsx evals/runner/run-memory-ab.ts",
    "motion-dsl:sync": "npm run sync --prefix ../../packages/motion-dsl",
    "motion-dsl:build": "npm run build --prefix ../../packages/motion-dsl",
    "motion-dsl:clean": "npm run clean --prefix ../../packages/motion-dsl",
    "motion-dsl:smoke": "npm run smoke --prefix ../../packages/motion-dsl",
    "assets:fetch": "npm run soundfont:fetch && npm run magenta:fetch && npm run sfx-library:packs",
    "eval:motion": "vitest run evals/motion-design/",
    "eval:motion:live": "tsx evals/motion-design/live-eval.ts",
    "eval:benchmark": "npx tsx --tsconfig evals/benchmark/tsconfig.json evals/benchmark/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fal-ai/serverless-client": "^0.15.0",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource-variable/vollkorn": "^5.2.10",
    "@fontsource/architects-daughter": "^5.2.7",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/bitter": "^5.2.10",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/kalam": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/patrick-hand": "^5.2.8",
    "@fontsource/permanent-marker": "^5.2.7",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/righteous": "^5.2.7",
    "@fontsource/sora": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@fontsource/work-sans": "^5.2.8",
    "@google/genai": "^1.46.0",
    "@libsql/client": "^0.17.2",
    "@lobehub/icons": "^5.10.0",
    "@magenta/music": "^1.23.1",
    "@mediapipe/tasks-vision": "0.10.17",
    "@monaco-editor/react": "^4.6.0",
    "@sentry/electron": "^5.11.0",
    "@tensorflow/tfjs": "^2.8.6",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.18.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.7",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.8.3",
    "fix-webm-duration": "^1.0.6",
    "geist": "^1.7.0",
    "html2canvas": "^1.4.1",
    "jsdom": "^29.1.1",
    "jsfxr": "^1.4.1",
    "lucide-react": "^0.400.0",
    "mediabunny": "^1.40.1",
    "motion": "^12.38.0",
    "next": "^16.2.1",
    "openai": "^6.33.0",
    "pdfjs-dist": "^4.10.38",
    "pixi.js": "^8.17.1",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "spessasynth_core": "^4.3.10",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tonal": "^6.4.3",
    "uuid": "^9.0.0",
    "web-demuxer": "^4.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^4.5.0",
    "zzfx": "^1.3.2"
  },
  "devDependencies": {
    "@dreambyte/player": "*",
    "@dreambyte/render-server": "*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/cli": "^2.39.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4",
    "ws": "^8.20.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.dreambyte.studio",
    "productName": "Dreambyte",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "danrublop",
        "repo": "dreambyte",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "src/lib/db/migrations/**/*",
      "package.json",
      "!node_modules/next/**",
      "!node_modules/@next/**",
      "!node_modules/@swc/**",
      "!node_modules/typescript/**",
      "!node_modules/@vitejs/**",
      "!node_modules/vite/**",
      "!node_modules/vitest/**",
      "!node_modules/@testing-library/**",
      "!node_modules/eslint/**",
      "!node_modules/eslint-*/**",
      "!node_modules/@eslint/**",
      "!node_modules/typescript-eslint/**",
      "!node_modules/prettier/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/electron-icon-builder/**",
      "!node_modules/esbuild/**",
      "!node_modules/@esbuild/**",
      "!node_modules/drizzle-kit/**",
      "!node_modules/turbo*/**",
      "!node_modules/@turbo/**",
      "!node_modules/concurrently/**",
      "!node_modules/wait-on/**",
      "!node_modules/husky/**",
      "!node_modules/lint-staged/**",
      "!node_modules/postcss/**",
      "!node_modules/autoprefixer/**",
      "!node_modules/tailwindcss/**",
      "!node_modules/three-bvh-csg/**",
      "!node_modules/tsx/**",
      "!node_modules/@babel/**",
      "!node_modules/babel-*/**",
      "!node_modules/@fontsource/**",
      "!node_modules/@fontsource-variable/**",
      "!node_modules/three/**",
      "!node_modules/@react-three/**",
      "!node_modules/@react-spring/**",
      "!node_modules/@dimforge/**",
      "!node_modules/@pixi/**",
      "!node_modules/pixi.js/**",
      "!node_modules/@mediapipe/**",
      "!node_modules/@monaco-editor/**",
      "!node_modules/@monogrid/**",
      "!node_modules/monaco-editor/**",
      "!node_modules/lottie-*/**",
      "!node_modules/@lottiefiles/**",
      "!node_modules/rive-*/**",
      "!node_modules/@rive-app/**",
      "!node_modules/d3-*/**",
      "!node_modules/d3/**",
      "!node_modules/plotly.js*/**",
      "!node_modules/chart.js/**",
      "!node_modules/rough-*/**",
      "!node_modules/@reduxjs/**",
      "!node_modules/redux*/**",
      "!node_modules/react-redux/**",
      "!node_modules/zustand/**",
      "!node_modules/@dnd-kit/**",
      "!node_modules/lucide-react/**",
      "!node_modules/react-*/**",
      "!node_modules/@radix-ui/**",
      "!node_modules/sonner/**",
      "!node_modules/sortablejs/**",
      "!node_modules/framer-motion/**",
      "!node_modules/motion/**",
      "!node_modules/@motionone/**",
      "!node_modules/animejs/**",
      "!node_modules/tailwind-merge/**",
      "!node_modules/clsx/**",
      "!node_modules/class-variance-authority/**",
      "!node_modules/canvas/**",
      "!node_modules/@panva/**",
      "!node_modules/@types/**",
      "!node_modules/@modelcontextprotocol/**",
      "!node_modules/@vitest/**",
      "!**/*.md",
      "!**/*.d.ts",
      "!**/CHANGELOG*",
      "!**/LICENSE*",
      "!**/README*",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@libsql/**",
      "node_modules/libsql/**"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../docs/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../docs/THIRD_PARTY_AUDIO.md",
        "to": "THIRD_PARTY_AUDIO.md"
      },
      {
        "from": "../../node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "../../node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "../../packages/render-server/stitcher.js",
        "to": "render-server/stitcher.js"
      },
      {
        "from": "../../packages/render-server/xfade-timeline.js",
        "to": "render-server/xfade-timeline.js"
      },
      {
        "from": "../../packages/render-server/audio-mixer.js",
        "to": "render-server/audio-mixer.js"
      },
      {
        "from": "../../packages/render-server/audio-filter.js",
        "to": "render-server/audio-filter.js"
      },
      {
        "from": "../../packages/render-server/ffmpeg-path.js",
        "to": "render-server/ffmpeg-path.js"
      },
      {
        "from": "../../packages/render-server/ffmpeg-runner.mjs",
        "to": "render-server/ffmpeg-runner.mjs"
      },
      {
        "from": "../../node_modules",
        "to": "render-server/node_modules",
        "filter": [
          "fluent-ffmpeg/**",
          "async/**",
          "which/**",
          "isexe/**",
          "uuid/**"
        ]
      },
      {
        "from": ".claude/skills/dreambyte",
        "to": "skill-data/dreambyte"
      },
      {
        "from": "src/lib/skills/library",
        "to": "skill-data/library"
      },
      {
        "from": "docs/agent",
        "to": "docs-agent"
      },
      {
        "from": "../../packages/player/dist/dreambyte-player.iife.js",
        "to": "player/player.js"
      },
      {
        "from": "sidecars/marlin",
        "to": "sidecars/marlin",
        "filter": [
          "marlin_server.py",
          "requirements.txt"
        ]
      },
      {
        "from": "scripts/mcp/mcp-connect.js",
        "to": "scripts/mcp/mcp-connect.js"
      },
      {
        "from": "scripts/mcp/mcp-select.cjs",
        "to": "scripts/mcp/mcp-select.cjs"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Dreambyte uses the camera so you can record avatar walkthroughs and narration clips directly inside the editor.",
        "NSMicrophoneUsageDescription": "Dreambyte uses the microphone so you can record narration and voiceover for scenes.",
        "NSScreenCaptureUsageDescription": "Dreambyte captures the screen when you use the screen-recording source in a scene."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo"
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120,
    "tabWidth": 2,
    "bracketSpacing": true,
    "arrowParens": "always"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {},
      "autoprefixer": {}
    }
  }
}
