# Dreambyte development environment.
# Copy to `.env` (or `.env.local`) at the repo root. Every key is optional — the
# desktop app also lets you add provider keys in Settings. Packaged builds read
# `<userData>/dreambyte.env` instead of this file.

# ─── Database ───────────────────────────────────────────
# SQLite via libSQL. The desktop app defaults to `<userData>/dreambyte.db`;
# set this only to point at a different file.
# DATABASE_URL=file:./dev.db

# ─── Model providers (at least one for the agent) ───────
# Pick a tier (auto / budget / premium) in the app; the agent runs on the
# matching provider and falls back to whichever key you have set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
# Local models via Ollama or any OpenAI-compatible endpoint
# OLLAMA_ENDPOINT=http://localhost:11434

# Web search for models without native search
TAVILY_API_KEY=

# ─── Media generation ───────────────────────────────────
FAL_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
# Local VoxCPM2 TTS server (python sidecars/voxcpm/server.py)
# VOXCPM_URL=http://localhost:8100

# ─── Stock media, music, and sound effects ──────────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=
LOTTIEFILES_API_KEY=

# ─── Telemetry and crash reports (off unless set) ───────
# See docs/TELEMETRY.md. DREAMBYTE_TELEMETRY_DISABLED=1 disables both.
# DREAMBYTE_TELEMETRY_URL=
# DREAMBYTE_TELEMETRY_API_KEY=
# DREAMBYTE_SENTRY_DSN=
